"[\n  {\n    \"title\": \"Wildfire and the Quest for Control: Why do we keep getting burned?\",\n    \"description\": \"Free Public Forum Wildfires are one of the greatest societal challenges of the 2lst century, but our solutions aren't working. The Philosophy of Science Association (PSA) Public Forum invites you to join experts Alexandra Syphard and Richard Halsey for an interactive conversation on the philosophical challenges surrounding the complexity of wildfires. We will explore questions about how our assumptions, values, and scientific knowledge jointly impact our quest to control the wildfire challenge. And, well consider how to take steps together toward a better future. Hosted by UCSD philosophy professor Karen Kovaka, this event is free and open to all. About the Speakers Alexandra Syphard Director: Global Wildfire Collective and Senior Research Scientist, Conservation Biology Institute Richard W. Halsey: Director and Founder, California Chaparral Institute Panel Host: Karen Kovaka, Assistant Professor of Philosophy, UC San Diego Sponsored by The Minnesota Center for Philosophy of Science and the W.K. Kellogg Foundation Chair, Department of Philosophy, Michigan State University\",\n    \"date\": \"2026-11-19\",\n    \"start_time\": \"19:00\",\n    \"end_time\": \"21:00\",\n    \"location\": \"San Diego Library - Central Branch\",\n    \"address\": \"330 Park Blvd, San Diego, CA 92101\",\n    \"provides_food\": null,\n    \"is_free\": true,\n    \"food_description\": null,\n    \"eligibility\": \"open to all\",\n    \"registration_url\": \"https://calendar.ucsd.edu/event/54436916814854/confirm?instance_id=54436916815879&return=https%3A%2F%2Fcalendar.ucsd.edu%2Fstudent-life%3Fevent_types%255B%255D%3D48402145550025%26instance_id%3D52676544709802%26school%3Ducsd\",\n    \"event_url\": \"https://calendar.ucsd.edu/event/wildfire-and-the-quest-for-control-why-do-we-keep-getting-burned\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"Wildfire and the Quest for Control: Why do we keep getting burned?\",\n      \"date\": \"Thu, Nov 19\",\n      \"time\": \"7pm to 9pm PST\",\n      \"location\": \"San Diego Library - Central Branch\",\n      \"provides_food\": null,\n      \"is_free\": \"Free Public Forum\",\n      \"food_description\": null,\n      \"eligibility\": \"open to all\"\n    }\n  }\n]"
