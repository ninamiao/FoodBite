"[\n  {\n    \"title\": \"Destress with CLS: Community Hour\",\n    \"description\": \"Join Chicanx and Latinx Studies for a cozy community hour! Enjoy hot chocolate, pan dulce, and crafts as we relax, create, and connect in community. Come as you are, take a break from the hustle, and spend some time with the CLS community. Let's Reflect Together Ancestral Knowledge: What wisdom or traditions have you inherited from your family or community that help you navigate difficult times or resist the pressure to always be productive? Collective Care: How do our communities teach us to care for one another? What can we learn from those practices? Redefining Success: What might success look like if we valued rest, relationships, joy, and community just as much as achievement? Take a break, get creative, share your thoughts, and connect with others in a welcoming space. We look forward to seeing you there!\",\n    \"date\": \"2026-12-02\",\n    \"start_time\": \"14:00\",\n    \"end_time\": \"15:30\",\n    \"location\": \"Student Center B\",\n    \"address\": \"9358 Mandeville Lane La Jolla, California 92093\",\n    \"provides_food\": true,\n    \"is_free\": true,\n    \"food_description\": \"hot chocolate, pan dulce\",\n    \"eligibility\": null,\n    \"registration_url\": \"https://calendar.ucsd.edu/event/chicanx-and-latinx-community-hour#tickets=1\",\n    \"event_url\": \"https://calendar.ucsd.edu/event/chicanx-and-latinx-community-hour\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"Destress with CLS: Community Hour\",\n      \"date\": \"Wed, Dec 2\",\n      \"time\": \"2pm to 3:30pm PST\",\n      \"location\": \"Student Center B\",\n      \"provides_food\": \"Enjoy hot chocolate, pan dulce, and crafts as we relax, create, and connect in community.\",\n      \"is_free\": \"0.0 | USD\",\n      \"food_description\": \"hot chocolate, pan dulce\",\n      \"eligibility\": null\n    }\n  }\n]"
