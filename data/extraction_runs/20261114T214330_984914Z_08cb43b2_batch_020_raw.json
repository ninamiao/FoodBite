"[\n  {\n    \"title\": \"GIS Mini Expo\",\n    \"description\": \"Celebrate UC GIS Week with UC San Diego Library and UC San Diego Young Planners’ Society for a GIS Mini Expo! Drop in for an open expo event to celebrate and learn more about GIS technology. Hear from faculty, researchers, and industry leaders on how it’s used in fields like planning, connect with fellow mapmakers and engage with student work and participate in challenges and live demonstrations. Want to get hands-on with GIS? We recommend bringing your own laptop to make the most of the event’s interactive activities and demonstrations! Snacks and refreshments will be available as supplies last. To help ensure there is enough for everyone, we encourage an RSVP.\",\n    \"date\": \"2026-11-20\",\n    \"start_time\": \"13:00\",\n    \"end_time\": \"15:00\",\n    \"location\": \"Geisel Library\",\n    \"address\": \"9701 Hopkins Drive, La Jolla, CA 92093\",\n    \"provides_food\": true,\n    \"is_free\": true,\n    \"food_description\": \"Snacks and refreshments\",\n    \"eligibility\": null,\n    \"registration_url\": \"https://calendar.ucsd.edu/event/gis-mini-expo-2026#tickets=1\",\n    \"event_url\": \"https://calendar.ucsd.edu/event/gis-mini-expo-2026\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"GIS Mini Expo\",\n      \"date\": \"2026-11-20\",\n      \"time\": \"13:00\",\n      \"location\": \"Geisel Library\",\n      \"provides_food\": \"Snacks and refreshments will be available as supplies last.\",\n      \"is_free\": \"0.0 | USD\",\n      \"food_description\": \"Snacks and refreshments\",\n      \"eligibility\": null\n    }\n  }\n]"
