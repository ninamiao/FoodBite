"[\n  {\n    \"title\": \"Grim\",\n    \"description\": \"GRIM is an irreverent, hilarious and heartbreaking world premiere musical that celebrates life… and death. After 300,000 years collecting souls, the Grim Reaper is retiring and his daughter Diana must pass a simple test to take over. That is, until she unexpectedly falls for dorky human Josh, and the beautiful chaos of humanity, planet Earth… and the DMV. If she loves life, can Diana be in charge of ending it? With an all-star creative team, an infectious score and sharp humor, GRIM will delight audiences with a bold and original theatrical experience. Premiering at San Diego’s renowned theatre company located on the UCSD campus. UCSD students with a valid student ID are encouraged to use the promo code TRITON to access $15 student tickets (restrictions apply).\",\n    \"date\": \"2026-11-14\",\n    \"start_time\": null,\n    \"end_time\": null,\n    \"location\": \"La Jolla Playhouse\",\n    \"address\": \"2910 La Jolla Village Drive, La Jolla, CA 92093\",\n    \"provides_food\": null,\n    \"is_free\": false,\n    \"food_description\": null,\n    \"eligibility\": \"UCSD students with a valid student ID are encouraged to use the promo code TRITON to access $15 student tickets (restrictions apply).\",\n    \"registration_url\": \"https://lajollaplayhouse.org/show/grim/?utm_source=listings&utm_medium=display&utm_campaign=P27GRI\",\n    \"event_url\": \"https://calendar.ucsd.edu/event/grim-678\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"Grim\",\n      \"date\": \"Sat, Nov 14\",\n      \"time\": null,\n      \"location\": \"La Jolla Playhouse\",\n      \"provides_food\": null,\n      \"is_free\": \"Student tickets available for $15\",\n      \"food_description\": null,\n      \"eligibility\": \"UCSD students with a valid student ID are encouraged to use the promo code TRITON to access $15 student tickets (restrictions apply).\"\n    }\n  }\n]"
