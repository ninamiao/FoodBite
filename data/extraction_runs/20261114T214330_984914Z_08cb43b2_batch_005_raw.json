"[\n  {\n    \"title\": \"A Streetcar Named Desire\",\n    \"description\": \"Tennessee Williams's A Streetcar Named Desire follows Blanche DuBois, a woman of fading grandeur, as she collides with the volatile world of her sister Stella and brother-in-law Stanley Kowalski in 1940s New Orleans. Their collision builds toward an inevitable, devastating tragedy. This production reimagines the play with a diverse ensemble cast, transforming Williams's story of a fading white Southern aristocracy into a sharper exploration of class mobility, cultural assimilation, and the pressure many communities of color have faced to conform to white-coded standards of class and culture in a rapidly changing America. Directed by Ian Anthony Coleman (MFA 2)\",\n    \"date\": \"2026-11-14\",\n    \"start_time\": \"14:00\",\n    \"end_time\": null,\n    \"location\": \"Theodore and Adele Shank Theatre\",\n    \"address\": \"2910 La Jolla Village Dr, La Jolla, California, 92093\",\n    \"provides_food\": null,\n    \"is_free\": false,\n    \"food_description\": null,\n    \"eligibility\": null,\n    \"registration_url\": \"https://theatre.ucsd.edu/performances-and-events/theatre-performances/a-streetcar-named-desire.html\",\n    \"event_url\": \"https://calendar.ucsd.edu/event/a-streetcar-named-desire\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": null,\n      \"date\": null,\n      \"time\": null,\n      \"location\": null,\n      \"provides_food\": null,\n      \"is_free\": \"Student $12.50 | Alumni/Staff $18 | General $25\",\n      \"food_description\": null,\n      \"eligibility\": null\n    }\n  }\n]"
