"[\n  {\n    \"title\": \"UC GIS Week 2026\",\n    \"description\": \"The University of California is hosting its annual GIS Week, taking place November 17-19, to celebrate all things mapping and geospatial! Join UC faculty, staff, students and alumni — as well as participants from beyond the UC system — for three days of lightning talks, presentations, workshops and a virtual gallery showcasing innovative mapping projects. A full schedule of events is available on the UC GIS Week website. In addition to the UC-wide virtual sessions, the Library will host two in-person events at Geisel Library: Mapathon – Wednesday, November 18: Contribute to a global mapping effort and connect with fellow mappers. No experience or skill required, but please bring your own laptop. UC GIS Week Mini Expo – Friday, November 20: Explore live demos and connect with campus partners using GIS in innovative ways. Presented by the Library and UC San Diego Young Planners’ Society. All UC GIS Week sessions are free and open to the public.\",\n    \"date\": \"2026-11-17\",\n    \"start_time\": null,\n    \"end_time\": null,\n    \"location\": null,\n    \"address\": null,\n    \"provides_food\": null,\n    \"is_free\": true,\n    \"food_description\": null,\n    \"eligibility\": \"open to the public\",\n    \"registration_url\": \"https://community-ucgis.hub.arcgis.com/pages/uc-gis-week-2026\",\n    \"event_url\": \"https://calendar.ucsd.edu/event/uc-gis-week-2026\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"UC GIS Week 2026\",\n      \"date\": \"2026-11-17\",\n      \"time\": null,\n      \"location\": null,\n      \"provides_food\": null,\n      \"is_free\": \"All UC GIS Week sessions are free and open to the public.\",\n      \"food_description\": null,\n      \"eligibility\": \"All UC GIS Week sessions are free and open to the public.\"\n    }\n  }\n]"
