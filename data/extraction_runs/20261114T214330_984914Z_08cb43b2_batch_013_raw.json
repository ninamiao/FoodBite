"[\n  {\n    \"title\": \"SMART Recovery Mondays\",\n    \"description\": \"Got urges, habits, or patterns you'd like to better understand? 💭 Join us for SMART Recovery Mondays this Fall! Every week we'll dive into a new SMART Recovery tool you can use in everyday life. 📍 Tritons Health & Wellness Building 📍 3rd Floor Student Community Space 🕓 Mondays | 4-5 PM Discover how your thoughts influence your feelings and behaviors and learn practical strategies to navigate urges while staying aligned with what matters most to you. Everyone is welcome. Come as you are. 💙 Week 1 Topic: Using the ABC Exercise for Urges 🧠\",\n    \"date\": \"2026-11-16\",\n    \"start_time\": \"16:00\",\n    \"end_time\": \"17:00\",\n    \"location\": \"Triton Health and Wellness Building\",\n    \"address\": \"9520 Gilman Dr , La Jolla, CA 92093\",\n    \"provides_food\": null,\n    \"is_free\": null,\n    \"food_description\": null,\n    \"eligibility\": \"Everyone is welcome.\",\n    \"registration_url\": \"https://calendar.ucsd.edu/event/54099005734297/confirm?instance_id=54099005746593&return=https%3A%2F%2Fcalendar.ucsd.edu%2Fstudent-life%3Fevent_types%255B%255D%3D48402145550025%26instance_id%3D52676544709802%26school%3Ducsd\",\n    \"event_url\": \"https://calendar.ucsd.edu/event/smart-recovery-mondays\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"SMART Recovery Mondays\",\n      \"date\": \"Mon, Nov 16\",\n      \"time\": \"4pm to 5pm\",\n      \"location\": \"Triton Health and Wellness Building, 3rd Floor Student Community Space\",\n      \"provides_food\": null,\n      \"is_free\": null,\n      \"food_description\": null,\n      \"eligibility\": \"Everyone is welcome.\"\n    }\n  }\n]"
