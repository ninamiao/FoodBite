"[\n  {\n    \"title\": \"Perspectives | In Your Words\",\n    \"description\": \"Perspectives | In Your Words is a photographic exhibition and interactive multimedia experience built from the voices of UC San Diego students. Student portraits accompany anonymous journal entries and unscripted conversations, together conveying what it feels like to be a student, in students' own words. At the listening stations, you can hear students talk about belonging, human connection, defining success, health, stress, and happiness. Take a question with you, and leave your own response for the next person. Hundreds of voices and room for more. Willo is building in public. Come see early designs for what's next, and tell us what you think. What we hear from students shapes what we build.\",\n    \"date\": \"2026-11-16\",\n    \"start_time\": \"17:00\",\n    \"end_time\": \"20:30\",\n    \"location\": \"Craft Center | 9605 Scholars Drive North, La Jolla, CA 92093\",\n    \"address\": \"9605 Scholars Drive North, La Jolla, CA 92093\",\n    \"provides_food\": null,\n    \"is_free\": null,\n    \"food_description\": null,\n    \"eligibility\": null,\n    \"registration_url\": \"https://www.eventbrite.com/e/perspectives-in-your-words-tickets-2003619300263\",\n    \"event_url\": \"https://calendar.ucsd.edu/event/perspectives-in-your-words\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"Perspectives | In Your Words\",\n      \"date\": \"Mon, Nov 16\",\n      \"time\": \"5pm to 8:30pm PST\",\n      \"location\": \"Craft Center\",\n      \"provides_food\": null,\n      \"is_free\": null,\n      \"food_description\": null,\n      \"eligibility\": null\n    }\n  }\n]"
