"[\n  {\n    \"title\": \"Welcome to UC San Diego | Exhibit\",\n    \"description\": \"In 2005, UC San Diego Chancellor Marye Anne Fox inaugurated a “lunch with the Chancellor” program for undergraduates, and Chancellor Pradeep K. Khosla has continued the program as the Chancellor’s Lunchbox Club for staff. This exhibit showcases a selection of these lunchboxes from the UC San Diego Archives, offering a lighthearted look at a unique UC San Diego tradition. Welcome to UC San Diego is on view in The Nest on the 2nd (main) Floor of Geisel Library during the building's open hours from Saturday, October 3, through Sunday, December 20, 2026.\",\n    \"date\": \"2026-11-14\",\n    \"start_time\": null,\n    \"end_time\": null,\n    \"location\": \"Geisel Library\",\n    \"address\": \"9701 Hopkins Drive, La Jolla, CA 92093\",\n    \"provides_food\": null,\n    \"is_free\": true,\n    \"food_description\": null,\n    \"eligibility\": null,\n    \"registration_url\": null,\n    \"event_url\": \"https://calendar.ucsd.edu/event/welcome-to-ucsd-exhibit-fall26\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"Welcome to UC San Diego | Exhibit\",\n      \"date\": \"Saturday, October 3, through Sunday, December 20, 2026\",\n      \"time\": null,\n      \"location\": \"Geisel Library\",\n      \"provides_food\": null,\n      \"is_free\": \"Free\",\n      \"food_description\": null,\n      \"eligibility\": null\n    }\n  }\n]"
