"[\n  {\n    \"title\": \"Showcase QI\",\n    \"description\": \"You are cordially invited to visit Showcase QI on the first floor of Atkinson Hall (around the corner from Gallery QI and across from Spatial Computing) at the Qualcomm Institute to experience a self-guided tour of stations representing a slice of the Qualcomm Institute at UC San Diego. The show includes video, audio and other material about some of the research, education and shared facilities at the institute. Showcase QI is open from 10 a.m. to 5 p.m., Monday through Friday. We may also have extended hours for special events, such as IDEAS performances and Gallery QI receptions. Please drop by to learn more about the breadth of interdisciplinary activities at QI. For more information, please email qi-communications@ucsd.edu or visit qi.ucsd.edu.\",\n    \"date\": \"2026-11-16\",\n    \"start_time\": \"10:00\",\n    \"end_time\": \"17:00\",\n    \"location\": \"Aktinson Hall\",\n    \"address\": \"3195 Voigt Drive, La Jolla, CA 92093\",\n    \"provides_food\": null,\n    \"is_free\": true,\n    \"food_description\": null,\n    \"eligibility\": null,\n    \"registration_url\": null,\n    \"event_url\": \"https://calendar.ucsd.edu/event/showcase-qi\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"Showcase QI\",\n      \"date\": \"2026-11-16\",\n      \"time\": \"10 a.m. to 5 p.m.\",\n      \"location\": \"Aktinson Hall\",\n      \"provides_food\": null,\n      \"is_free\": \"Free\",\n      \"food_description\": null,\n      \"eligibility\": null\n    }\n  }\n]"
