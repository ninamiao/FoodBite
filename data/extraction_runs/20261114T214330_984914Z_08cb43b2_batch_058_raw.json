"[\n  {\n    \"title\": \"The Human Condition: An Exploration of Art & Literature | Exhibit\",\n    \"description\": \"The Human Condition: An Exploration of Art & Literature is an annual art and literary magazine created by medical students for the UC San Diego School of Medicine community. Now in its 32nd year, the student-led publication features art, photography, poetry, prose, sculpture, comics and more, providing a space for safe expression, creativity and exploring identities beyond medicine. This exhibition presents selected works from the 2025 and 2026 issues, offering a glimpse into the experiences, perspectives and creative lives of the School of Medicine community. Visitors are invited to pause, reflect and explore the many dimensions of the human experience. The Human Condition: An Exploration of Art & Literature is on view in the Sally T. WongAvery Library breezeway from September 26 to December 13, 2026, during the building's open hours. Previous issues of The Human Condition magazine, dating back to 2007-08, are available to download and read at your leisure. Curated by: Amy Xue, MS4, editor-in-chief, 2026-27 Myat Wai, MS4, editor-in-chief, 2026-27Supported by: UC San Diego School of MedicineUC San Diego Library\",\n    \"date\": \"2026-11-14\",\n    \"start_time\": null,\n    \"end_time\": null,\n    \"location\": \"Sally T. WongAvery Library\",\n    \"address\": \"3100 Biomedical Sciences Wy La Jolla, CA 92093\",\n    \"provides_food\": null,\n    \"is_free\": true,\n    \"food_description\": null,\n    \"eligibility\": null,\n    \"registration_url\": null,\n    \"event_url\": \"https://calendar.ucsd.edu/event/the-human-condition-exhibit\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"The Human Condition: An Exploration of Art & Literature | Exhibit\",\n      \"date\": null,\n      \"time\": null,\n      \"location\": \"Sally T. WongAvery Library\",\n      \"provides_food\": null,\n      \"is_free\": \"Free\",\n      \"food_description\": null,\n      \"eligibility\": null\n    }\n  }\n]"
