"[\n  {\n    \"title\": \"Native American Heritage Month Book Display\",\n    \"description\": \"In honor of Native American Heritage Month, explore a curated collection of books that highlight the history, culture and experiences of the Native American and Alaska Native community. Throughout November, visit the Meet Spot near Geisel Library’s main entrance during building open hours to browse a selection of indigenous-related titles available for checkout. Can’t make it to the display? Many of the featured books are also included in the Library’s online Recommended Reading List Guide, making it easy to discover new perspectives and deepen your understanding of the cultures wherever you are.\",\n    \"date\": \"2026-11-14\",\n    \"start_time\": null,\n    \"end_time\": null,\n    \"location\": \"Geisel Library\",\n    \"address\": \"9701 Hopkins Drive, La Jolla, CA 92093\",\n    \"provides_food\": null,\n    \"is_free\": true,\n    \"food_description\": null,\n    \"eligibility\": null,\n    \"registration_url\": null,\n    \"event_url\": \"https://calendar.ucsd.edu/event/native-american-heritage-month-book-display-2026\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"Native American Heritage Month Book Display\",\n      \"date\": null,\n      \"time\": null,\n      \"location\": \"Geisel Library\",\n      \"provides_food\": null,\n      \"is_free\": \"Free\",\n      \"food_description\": null,\n      \"eligibility\": null\n    }\n  }\n]"
