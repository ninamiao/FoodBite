"[\n  {\n    \"title\": \"Beyond Sentences: Stories of Incarceration, Resilience, and Reentry\",\n    \"description\": \"Join UC San Diego OASIS Triton Underground Scholars and Playwrights Project for Beyond Sentences, a powerful theatrical production exploring the pathways to incarceration, the realities of confinement, and the challenges and triumphs of returning home. Developed by Playwrights Project's Returned Writers Circle, Beyond Sentences features a series of vignettes highlighting the experiences and perspectives of individuals impacted by the criminal justice system. The production includes works by writers currently incarcerated at Centinela and Richard J. Donovan Correctional Facilities, formerly incarcerated writers, and teens studying criminal justice. Through storytelling and performance, this event invites audiences to reflect on justice, rehabilitation, resilience, and the importance of amplifying voices too often excluded from public conversations. Event Details Date: Sunday, November 15, 2026 Time: 2:00 PM Location: The La Jolla Project (Revelle Lawn), UC San Diego Address: Scholars Drive South, La Jolla, CA 92037 Admission: Free and open to the general public; reservations required. Register: https://events.com/r/en_US/registration/beyond-sentences--ucsd-san-diego-november-1106439 Students, faculty, staff, families, and community members are all welcome. No UC San Diego affiliation is required. Presented by Playwrights Project in partnership with UC San Diego OASIS Triton Underground Scholars.\",\n    \"date\": \"2026-11-15\",\n    \"start_time\": \"14:00\",\n    \"end_time\": \"16:00\",\n    \"location\": \"The La Jolla Project (Revelle Lawn), UC San Diego\",\n    \"address\": \"Scholars Drive South, La Jolla, CA 92037\",\n    \"provides_food\": null,\n    \"is_free\": true,\n    \"food_description\": null,\n    \"eligibility\": \"Students, faculty, staff, families, and community members are all welcome. No UC San Diego affiliation is required.\",\n    \"registration_url\": \"https://events.com/r/en_US/registration/beyond-sentences--ucsd-san-diego-november-1106439\",\n    \"event_url\": \"https://calendar.ucsd.edu/event/beyond-sentences-stories-of-incarceration-resilience-and-reentry\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"Beyond Sentences: Stories of Incarceration, Resilience, and Reentry\",\n      \"date\": \"Sunday, November 15, 2026\",\n      \"time\": \"2:00 PM\",\n      \"location\": \"The La Jolla Project (Revelle Lawn), UC San Diego\",\n      \"provides_food\": null,\n      \"is_free\": \"Free and open to the general public\",\n      \"food_description\": null,\n      \"eligibility\": \"Students, faculty, staff, families, and community members are all welcome. No UC San Diego affiliation is required.\"\n    }\n  }\n]"
