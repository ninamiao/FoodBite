"[\n  {\n    \"title\": \"Wander the Wetlands - Fish Seining at Crown Point Park\",\n    \"description\": \"Join UC San Diego Natural Reserve System and San Diego Bird Alliance every 2nd and 4th Saturday of the month from 9-11am for Wander the Wetlands! Wander the Wetlands is a chance for any and everyone to learn more about the history of the marsh, the unique habitats it holds, and the animals that call the Kendall-Frost Marsh home. No RSVP or registration needed. Each 2nd Saturday event is dedicated to science! Meet us at the northern end of Crown Point Park. These days, we will be doing fish seining. Please make sure to bring closed-toed shoes, sun protection, and water. Note that you will need to be able to navigate uneven, muddy, and/or rocky terrain. Additionally, while this event is family-friendly, no dogs or other pets are allowed inside the reserve. For more details, visit San Diego Bird Alliance's calendar: https://secure.sandiegobirdalliance.org/np/clients/sandiegobirdalliance/publicaccess/eventCalendarBig.jsp\",\n    \"date\": \"2026-11-14\",\n    \"start_time\": \"09:00\",\n    \"end_time\": \"11:00\",\n    \"location\": \"Crown Point Park North\",\n    \"address\": null,\n    \"provides_food\": null,\n    \"is_free\": true,\n    \"food_description\": null,\n    \"eligibility\": \"any and everyone\",\n    \"registration_url\": null,\n    \"event_url\": \"https://calendar.ucsd.edu/event/wander-the-wetlands-science\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"Wander the Wetlands - Fish Seining at Crown Point Park\",\n      \"date\": \"Sat, Nov 14\",\n      \"time\": \"9am to 11am\",\n      \"location\": \"Crown Point Park North\",\n      \"provides_food\": null,\n      \"is_free\": \"Free Event\",\n      \"food_description\": null,\n      \"eligibility\": \"any and everyone\"\n    }\n  }\n]"
