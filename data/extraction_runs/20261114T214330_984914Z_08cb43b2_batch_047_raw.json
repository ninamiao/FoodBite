"[\n  {\n    \"title\": \"MLIS & Library Careers Panel\",\n    \"description\": \"Are you an undergraduate interested in exploring a career in archives and libraries? Join the UC San Diego Library and the Undergraduate History Network (UHN) for this informal, drop-in session to learn about career opportunities in library science, archival work and related fields. UC San Diego Library librarians and archivists will be on hand to share insights about their work, discuss different career paths and answer questions about the field, including the Master of Library and Information Science (MLIS) degree and how to pursue a career in libraries and archives. Whether you're just beginning to explore these fields or already considering graduate school, stop by to ask questions and learn more! Open to currently enrolled UC San Diego students.\",\n    \"date\": \"2026-11-16\",\n    \"start_time\": \"14:00\",\n    \"end_time\": \"15:00\",\n    \"location\": \"Geisel Library\",\n    \"address\": \"9701 Hopkins Drive, La Jolla, CA 92093\",\n    \"provides_food\": null,\n    \"is_free\": null,\n    \"food_description\": null,\n    \"eligibility\": \"Open to currently enrolled UC San Diego students.\",\n    \"registration_url\": \"https://docs.google.com/forms/d/e/1FAIpQLSeY-lswOIQd3nnIjgRDtJwViklJqS42BFHIbZ96wW73XVG7FQ/viewform\",\n    \"event_url\": \"https://calendar.ucsd.edu/event/mlis-library-careers-panel-fall26\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"MLIS & Library Careers Panel\",\n      \"date\": \"Mon, Nov 16\",\n      \"time\": \"2pm to 3pm PST\",\n      \"location\": \"Geisel Library\",\n      \"provides_food\": null,\n      \"is_free\": null,\n      \"food_description\": null,\n      \"eligibility\": \"Open to currently enrolled UC San Diego students.\"\n    }\n  }\n]"
