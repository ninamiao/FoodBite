"[\n  {\n    \"title\": \"Exploring Connection: Books on Friendship, Community & Belonging\",\n    \"description\": \"Social connection matters for your health and well-being. Strong social ties may protect against illness, ease stress, and even add years to your life – while isolation and loneliness raise the risk of illness, according to the U.S. Surgeon General’s Advisory on Social Connection. This November, visit the Meet Spot in Geisel Library's lobby during building open hours to explore books on friendship, community, and belonging. Our display features practical guides on building connection, research on why it matters, and stories that explore what belonging feels like. See the full book list. We developed this display as part of the San Diego Circuit Belonging & Mental Wellness Campaign, a collaborative effort by libraries across San Diego County to foster community and support mental health. Students, faculty, and staff can use Circuit to request additional books from participating libraries, including bestsellers, popular fiction, and other titles not in our collection. Visit lib.ucsd.edu/circuit for details.\",\n    \"date\": null,\n    \"start_time\": null,\n    \"end_time\": null,\n    \"location\": \"Geisel Library\",\n    \"address\": \"9701 Hopkins Drive, La Jolla, CA 92093\",\n    \"provides_food\": null,\n    \"is_free\": null,\n    \"food_description\": null,\n    \"eligibility\": null,\n    \"registration_url\": null,\n    \"event_url\": \"https://calendar.ucsd.edu/event/belonging-and-mental-wellness\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"Exploring Connection: Books on Friendship, Community & Belonging\",\n      \"date\": null,\n      \"time\": null,\n      \"location\": \"Geisel Library\",\n      \"provides_food\": null,\n      \"is_free\": null,\n      \"food_description\": null,\n      \"eligibility\": null\n    }\n  }\n]"
