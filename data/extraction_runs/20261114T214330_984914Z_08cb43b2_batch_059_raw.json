"[\n  {\n    \"title\": \"United States Poets Laureate | Exhibit\",\n    \"description\": \"Explore the works of the U.S. Poets Laureate through selected books and broadsides held in the Archive of New Poetry, a part of UC San Diego Library's Special Collections & Archives. United States Poets Laureate is on view outside of Special Collections & Archives on the 2nd (main) Floor of Geisel Library during the building's open hours through Sunday, December 13, 2026. Image taken from \\\"A Map to the Next World\\\" by 2019-2022 Poet Laureate Joy Harjo. Harjo was the first Native American Poet Laureate and centered her term on celebrating indigenous poetry and voices with her project \\\"Living Nations, Living Worlds.\\\"\",\n    \"date\": \"2026-11-14\",\n    \"start_time\": null,\n    \"end_time\": null,\n    \"location\": \"Geisel Library\",\n    \"address\": null,\n    \"provides_food\": null,\n    \"is_free\": true,\n    \"food_description\": null,\n    \"eligibility\": null,\n    \"registration_url\": null,\n    \"event_url\": \"https://calendar.ucsd.edu/event/united-states-poet-laureates-exhibit-fall26\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"United States Poets Laureate | Exhibit\",\n      \"date\": null,\n      \"time\": null,\n      \"location\": \"Geisel Library\",\n      \"provides_food\": null,\n      \"is_free\": \"Free\",\n      \"food_description\": null,\n      \"eligibility\": null\n    }\n  }\n]"
