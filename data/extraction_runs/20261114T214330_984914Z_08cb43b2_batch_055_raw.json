"[\n  {\n    \"title\": \"Library Milestones | Exhibit\",\n    \"description\": \"Before the rise of digital publications and licensed electronic resources, academic libraries measured the size of their collections by the number of physical volumes on their shelves. Reaching a million-volume milestone was a source of pride and a mark of growth. This exhibit highlights five titles that mark milestones in the growth of the UC San Diego Library’s physical collections. Together, they also reflect the generosity of donors and support groups who helped build the collections and offer a glimpse into what made a book milestone-worthy at the time. Library Milestones is on view outside of Special Collections & Archives on the 2nd (main) Floor of Geisel Library during the building's open hours through Sunday, December 13, 2026. Photo citation: John Ogilby. America: being the latest, and most accurate description of the New World; containing the original inhabitants, and the remarkable voyages thither... London: printed by the author, 1671. UC San Diego Library, Special Collections & Archives.\",\n    \"date\": \"2026-11-14\",\n    \"start_time\": null,\n    \"end_time\": null,\n    \"location\": \"Geisel Library\",\n    \"address\": \"9701 Hopkins Drive, La Jolla, CA 92093\",\n    \"provides_food\": null,\n    \"is_free\": true,\n    \"food_description\": null,\n    \"eligibility\": null,\n    \"registration_url\": null,\n    \"event_url\": \"https://calendar.ucsd.edu/event/library-milestones-exhibit-fall26\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"Library Milestones | Exhibit\",\n      \"date\": null,\n      \"time\": null,\n      \"location\": \"Geisel Library\",\n      \"provides_food\": null,\n      \"is_free\": \"Free\",\n      \"food_description\": null,\n      \"eligibility\": null\n    }\n  }\n]"
