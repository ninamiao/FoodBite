"[\n  {\n    \"title\": \"Research in the Arts and Humanities\",\n    \"description\": \"Dear students, join us for an informative presentation focused on research opportunities available for undergraduate students majoring in the Arts and Humanities. Have you ever been so invested in a topic that you spend hours reading different articles and books about it? That is research! Make it official by applying to the many opportunities available at the UC San Diego Research Hub. Many of these opportunities offer students stipends and are a good way to make your grad applications stand out, for those planning to extend their education. This event is open to all students of all majors, with an emphasis on the Arts and Humanities. Our presenter, Elizabeth Vazquez, is well acquainted with research opportunities for all majors and specializes in offering help to transfer students. There will be lunch and coffee available for all participants, so do not forget to RSVP by clicking the button above.\",\n    \"date\": \"2026-11-18\",\n    \"start_time\": \"12:30\",\n    \"end_time\": \"14:00\",\n    \"location\": \"Triton Center Building A\",\n    \"address\": \"9500 Gilman Drive, La Jolla, CA 92093\",\n    \"provides_food\": true,\n    \"is_free\": null,\n    \"food_description\": \"lunch and coffee\",\n    \"eligibility\": \"open to all students of all majors, with an emphasis on the Arts and Humanities\",\n    \"registration_url\": \"https://calendar.ucsd.edu/event/research-in-the-humanities#tickets=1\",\n    \"event_url\": \"https://calendar.ucsd.edu/event/research-in-the-humanities\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"Research in the Arts and Humanities\",\n      \"date\": \"Wed, Nov 18\",\n      \"time\": \"12:30pm to 2pm PST\",\n      \"location\": \"Triton Center Building A\",\n      \"provides_food\": \"There will be lunch and coffee available for all participants\",\n      \"is_free\": null,\n      \"food_description\": \"lunch and coffee\",\n      \"eligibility\": \"This event is open to all students of all majors, with an emphasis on the Arts and Humanities.\"\n    }\n  }\n]"
