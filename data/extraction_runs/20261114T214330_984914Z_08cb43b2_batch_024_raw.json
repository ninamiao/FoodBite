"[\n  {\n    \"title\": \"UC GIS Week Map-a-thon\",\n    \"description\": \"Join the Library for a Map-a-thon as part of the UC GIS Week. We will contribute to the Missing Maps project, which empowers volunteers to map vulnerable areas, assisting humanitarian organizations trying to meet the needs of people who live at risk of disasters and crises. Each year, disasters around the world affect or displace 200 million people. Many of the places where these disasters occur are literally ‘missing’ from open and accessible maps and first responders lack the information to make valuable decisions regarding relief efforts. We’ll trace buildings and roads from satellite images—no experience is required! Your contributions will support critical recovery efforts in crisis-prone regions. Join us for the whole event or drop in as your schedule allows. This is also a fun and meaningful way to de-stress. No experience or special skills are required. This is a Bring Your Own Device event, so bring your own laptops and chargers. Tell us you’re coming by registering today! What to do before the Mapathon Tutorials and Guides Online Tutorial made specifically for the Map-a-thonMapathon Quick Guide\",\n    \"date\": \"2026-11-18\",\n    \"start_time\": \"14:00\",\n    \"end_time\": \"16:00\",\n    \"location\": \"Geisel Library\",\n    \"address\": \"9701 Hopkins Drive, La Jolla, CA 92093\",\n    \"provides_food\": null,\n    \"is_free\": true,\n    \"food_description\": null,\n    \"eligibility\": null,\n    \"registration_url\": \"https://calendar.ucsd.edu/event/uc-gis-week-mapathon-2026#tickets=1\",\n    \"event_url\": \"https://calendar.ucsd.edu/event/uc-gis-week-mapathon-2026\",\n    \"source_url\": \"https://calendar.ucsd.edu/student-life\",\n    \"evidence\": {\n      \"title\": \"UC GIS Week Map-a-thon\",\n      \"date\": \"Wed, Nov 18\",\n      \"time\": \"2pm to 4pm PST\",\n      \"location\": \"Geisel Library\",\n      \"provides_food\": null,\n      \"is_free\": \"0.0 | USD\",\n      \"food_description\": null,\n      \"eligibility\": null\n    }\n  }\n]"
